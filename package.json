{
  "name": "midnight-studios",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/run-next.mjs dev",
    "build": "node scripts/run-next.mjs build",
    "start": "node scripts/serve-export.mjs",
    "lint": "eslint .",
    "check": "node --env-file=.env.production --env-file-if-exists=.env.local scripts/check-export.mjs && node scripts/check-release.mjs && node --experimental-strip-types scripts/check-homepage.mjs && node --experimental-strip-types scripts/check-media.mjs && node scripts/check-store-reviews.mjs && node --experimental-strip-types scripts/check-content.mjs && node --experimental-strip-types scripts/check-worlds.mjs && node --experimental-strip-types scripts/check-journal.mjs && node scripts/measure-delivery.mjs",
    "reviews:sync": "node --experimental-strip-types --env-file-if-exists=.env.local scripts/sync-store-reviews.mjs",
    "content:pull": "node --experimental-strip-types --env-file-if-exists=.env.local scripts/pull-content.mjs",
    "check:content": "node --experimental-strip-types scripts/check-content.mjs",
    "check:worlds": "node --experimental-strip-types scripts/check-worlds.mjs",
    "check:journal": "node --experimental-strip-types scripts/check-journal.mjs",
    "cms:pull": "node --experimental-strip-types --env-file-if-exists=.env.local scripts/pull-supabase.mjs",
    "check:dashboard": "node --experimental-strip-types scripts/check-dashboard.mjs && node scripts/check-dashboard-jobs.mjs",
    "build:cloudflare": "node scripts/build-cloudflare.mjs"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "radix-ui": "1.6.7",
    "lucide-react": "1.31.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0",
    "zod": "3.25.76",
    "server-only": "0.0.1",
    "@supabase/supabase-js": "2.118.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/node": "22.19.19",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "@electric-sql/pglite": "0.3.14"
  }
}
