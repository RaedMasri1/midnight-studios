# Optional .env.local for private review; this overrides production settings.
# Public production defaults are in .env.production. Never deploy this localhost origin.
SITE_URL=http://localhost:3000
SITE_INDEXABLE=false
# Optional CLI-only short-lived store tokens. Never use NEXT_PUBLIC_ for these.
APP_STORE_CONNECT_TOKEN=
GOOGLE_PLAY_ACCESS_TOKEN=
# Optional build-time CMS bridge. Never expose the token to client JavaScript.
CONTENT_API_URL=
CONTENT_API_TOKEN=

# Studio dashboard: use the public Project URL and PUBLISHABLE key only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Enable on your hosting build after initializing the CMS.
CMS_PUBLISH_FROM_SUPABASE=false
